# A-Share-Review 环境变量模板
# 复制为 .env 后填写（.env 已被 gitignore，绝不提交）。
# 所有密钥均为占位符；不得填入券商密码 / 短信验证码 / 交易密钥。

# --- 运行环境 ---
APP_ENV=development
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# --- 后端 ---
API_HOST=127.0.0.1
API_PORT=8000

# --- 数据存储（默认值，可覆盖） ---
DB_PATH=storage/db/ashare_review.db
CACHE_DIR=storage/cache
LOG_DIR=storage/logs
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
IMPORT_DIR=data/imports
EXPORT_DIR=data/exports
PRIVATE_DATA_DIR=data/private

# --- 数据源（可选，按需填写） ---
# AKShare 无需 token，默认启用
TUSHARE_TOKEN=

# --- 大模型（仅辅助解读；数值计算不使用 LLM） ---
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ollama（本地）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- 定时任务 ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
# 交易日复盘时间（本地时区，HH:MM）
DAILY_REVIEW_TIME=18:00
